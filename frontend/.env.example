# Copy to .env in this directory (Create React App reads REACT_APP_* from .env).
# cp .env.example .env

# Backend base URL (no trailing slash). Must match what the browser uses for API calls.
#
# Local development:
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
#
# Production (same-origin via Nginx — UI and /api on one host):
# REACT_APP_BACKEND_URL=https://fleet.gtiholding.com

# Fleet Map background map. By default the app reads the self-hosted file /maps/west-africa.pmtiles,
# which Nginx serves in production (see the runbook). For local development either put that file in
# frontend/public/maps/, or use OpenStreetMap's raster tiles (development only, not for production):
# REACT_APP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# REACT_APP_MAP_PMTILES_URL=/maps/west-africa.pmtiles
# REACT_APP_MAP_MAX_DATA_ZOOM=15
