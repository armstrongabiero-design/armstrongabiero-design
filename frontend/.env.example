# Copy to .env in this directory (Create React App reads REACT_APP_* from .env).
# cp .env.example .env

# Backend base URL (no trailing slash). Must match what the browser uses for API calls.
#
# Local development:
REACT_APP_BACKEND_URL=http://127.0.0.1:8000
#
# Production (same-origin via Nginx — UI and /api on one host):
# REACT_APP_BACKEND_URL=https://fleet.gtiholding.com

# Fleet Map tiles. Without these, development uses OpenStreetMap's own tile servers, which do not
# allow production business use. In production, set a licensed provider (e.g. MapTiler or Stadia)
# and add its host to img-src in the Nginx Content-Security-Policy. Baked in at build time.
# REACT_APP_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# REACT_APP_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
